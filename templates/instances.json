{
  "version": 1,
  "default_instance": "admin",
  "instances": {
    "admin": {
      "tmux_session": "claude-admin",
      "runtime": "claude",
      "enabled": true,
      "type": "dedicated",
      "primary": true,
      "auto_suspend": false,
      "state_dir": "~/zylos/activity-monitor/admin",
      "claude_md": "",
      "description": "Primary admin instance (always-on)"
    },
    "group": {
      "tmux_session": "claude-group",
      "runtime": "claude",
      "enabled": true,
      "type": "group",
      "primary": false,
      "auto_suspend": false,
      "state_dir": "~/zylos/instances/group",
      "claude_md": "",
      "description": "Group chat instance (handles all group conversations)"
    }
  },
  "routing": {}
}
